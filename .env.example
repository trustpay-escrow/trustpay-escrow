# ==============================================================================
# TrustPay Escrow — Comprehensive Environment Configuration Template
# ==============================================================================
# Copy this file to .env (or backend/.env and frontend/.env.local)
# For detailed variable definitions and security implications, see ENVIRONMENT.md

# ------------------------------------------------------------------------------
# 1. Stellar & Soroban Network Configuration
# ------------------------------------------------------------------------------
# Stellar network mode: testnet | futurenet | mainnet
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Deployed Soroban Escrow Smart Contract Address (WASM Contract ID)
NEXT_PUBLIC_ESCROW_CONTRACT_ID=CCW67TSB3SSS423DNE2B2RQLI274W2YQY35J5XEEGBB5AKWODHBB545G

# Default Arbiter Stellar Address (Used for dispute resolution)
NEXT_PUBLIC_DEFAULT_ARBITER_ADDRESS=GDFLMVB4TWEBF3EXD66IYLCZE2G75JWZ5ICPKBWPEW7EE5CCLJQGFHAX

# ------------------------------------------------------------------------------
# 2. Supported Asset Addresses on Stellar (SAC / Stellar Asset Contracts)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_USDC_TOKEN_ADDRESS=CCW67TSB3SSS423DNE2B2RQLI274W2YQY35J5XEEGBB5AKWODHBB545G
NEXT_PUBLIC_EURC_TOKEN_ADDRESS=CDLZFC3SYJYDVR72CC2CPEMV3N3K5ZCGKFW5R4GMLGQO6PBA3RPAV4T9
NEXT_PUBLIC_XLM_TOKEN_ADDRESS=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYZYY55COEHWY53
NEXT_PUBLIC_PYUSD_TOKEN_ADDRESS=CX7B65SS3SSS423DNE2B2RQLI274W2YQY35J5XEEGBB5AKWODHBB545G

# ------------------------------------------------------------------------------
# 3. Backend API Service Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------------------------------------------
# 4. Supabase Database & Metadata Storage (PostgreSQL)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://dummy-supabase-project.supabase.co
SUPABASE_ANON_KEY=dummy-anon-key-for-local-development-and-ci
SUPABASE_SERVICE_ROLE_KEY=dummy-service-role-key-for-local-development

NEXT_PUBLIC_SUPABASE_URL=https://dummy-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon-key-for-local-development-and-ci
NEXT_PUBLIC_API_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 5. Redis In-Memory Cache (Optional — graceful bypass if omitted)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
